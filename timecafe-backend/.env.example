# ==========================================
# Server
# ==========================================

PORT=5000
NODE_ENV=development


# ==========================================
# Frontend URL
# ==========================================

CLIENT_URL=http://127.0.0.1:5500


# ==========================================
# Backend URL
# ==========================================
BACKEND_URL=http://localhost:5000
  

# ==========================================
# Database
# ==========================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=timecafe_db
DB_USER=your_database_username
DB_PASSWORD=your_database_password_here


# ==========================================
# JWT Authentication
# ==========================================

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d


# ==========================================
# Chapa Payment
# ==========================================

CHAPA_SECRET_KEY=your_chapa_secret_key

CHAPA_CALLBACK_URL=http://localhost:5000/api/payments/webhook

CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret


# ==========================================
# Super Admin Seeder
# ========================================== 

SUPERADMIN_EMAIL=your_superadmin_email_here
SUPERADMIN_PASSWORD=your_secure_superadmin_password_here